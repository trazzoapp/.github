        "--dir",
        "trazzo-landing",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "trazzo-clients-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "trazzo-clients",
        "run",
        "dev"
      ],
      "port": 3003
    },
    {
      "name": "trazzo-admin-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "trazzo-admin",
        "run",
        "dev"
      ],
